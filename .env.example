# SmartHealth Environment Configuration Example

# Core
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api/v1

# Security & Authentication (Change in production!)
SECRET_KEY=smarthealth-dev-insecure-secret-key-change-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RATE_LIMIT_PER_MINUTE=120

# Google Cloud & Services
GCP_PROJECT_ID=smarthealth-india
USE_SECRET_MANAGER=false
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CACHE_TTL_SECONDS=3600

# Google Maps API (Optional, for full vector tile basemap)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Database
USE_MOCK_DB=true
FIRESTORE_DATABASE=(default)

# CORS Origins (Comma-separated or JSON list)
ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:3000"]
